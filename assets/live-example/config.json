uestHeaders"],"inlineExprChunks":["fable_modules/inline_exprs/inline_exprs_0.browser.json"]},"defaultPreset":"demo","presets":{"demo":{"files":[{"name":"Demo.fs","content":"module Demo\n\n/// A tiny stand-in for a library a site documents. Anything defined here is in scope in every\n/// snippet that asks for this preset, and the type-checker answers for it: hover `distance` in a\n/// snippet and it reports this signature.\ntype Point =\n    {\n        X: float\n        Y: float\n    }\n\nlet distance (a: Point) (b: Point) =\n    sqrt ((a.X - b.X) ** 2.0 + (a.Y - b.Y) ** 2.0)\n\nlet fizzbuzz n =\n    match n % 3, n % 5 with\n    | 0, 0 -> \"FizzBuzz\"\n    | 0, _ -> \"Fizz\"\n    | _, 0 -> \"Buzz\"\n    | _ -> string n\n"}],"css":"body {\n    margin: 0;\n    padding: 1rem;\n    font:\n        15px / 1.5 system-ui,\n        sans-serif;\n    color: #1a2129;\n}\n\n#app {\n    max-width: 28rem;\n}\n\nimg {\n    border-radius: 50%;\n}\n\nh2 {\n    margin: 0.6rem 0 0.2rem;\n    font-size: 1.1rem;\n}\n\np {\n    margin: 0.15rem 0;\n    color: #4a5560;\n}\n","template":"<!doctype html>\n<html lang=\"en\">\n    <head>\n        <meta charset=\"utf-8\" />\n        <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    </head>\n    <body>\n        <!-- Laid out before the snippet runs, so it has somewhere to draw. -->\n        <div id=\"app\"></div>\n    </body>\n</html>\n"}}}