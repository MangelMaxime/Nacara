<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageId>Nacara.Core</PackageId>
        <Description>Core engine of Nacara: content collections, routing, diagnostics and the plugin pipeline.</Description>
        <PackageTags>fsharp;documentation;static-site-generator;nacara</PackageTags>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="Paths.fs" />
        <Compile Include="ProjectCache.fs" />
        <Compile Include="Slug.fs" />
        <Compile Include="Locale.fs" />
        <Compile Include="Route.fs" />
        <Compile Include="Diagnostic.fs" />
        <Compile Include="Yaml.fs" />
        <Compile Include="CodeBlock.fs" />
        <Compile Include="Content.fs" />
        <Compile Include="Collection.fs" />
        <Compile Include="Registry.fs" />
        <Compile Include="Site.fs" />
        <Compile Include="Log.fs" />
        <Compile Include="Resource.fs" />
        <Compile Include="Tool.fs" />
        <Compile Include="Build.fs" />
        <Compile Include="DevServer.fs" />
        <Compile Include="Watcher.fs" />
        <Compile Include="Cli.fs" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="YamlDotNet" />
        <PackageReference Include="Feliz.ViewEngine" />
        <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" />
    </ItemGroup>
</Project>
