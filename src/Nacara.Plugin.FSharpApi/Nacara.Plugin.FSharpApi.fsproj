<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageId>Nacara.Plugin.FSharpApi</PackageId>
        <Description>API reference pages for F# libraries, read from the assemblies you ship.</Description>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="Model.fs" />
        <Compile Include="Signature.fs" />
        <Compile Include="XmlDocs.fs" />
        <Compile Include="Reader.fs" />
        <Compile Include="Render.fs" />
        <Compile Include="FSharpApi.fs" />
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="assets/fsharp-api.css" />
        <EmbeddedResource Include="assets/fsharp-api.js" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="FSharp.Compiler.Service" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../Nacara.Core/Nacara.Core.fsproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageVersion Update="FSharp.Core" Version="$(FSharpCoreWithFcs)" />
    </ItemGroup>
</Project>
